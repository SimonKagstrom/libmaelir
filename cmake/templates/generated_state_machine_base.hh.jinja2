{#-
  Template context:

    class_name:    Base name of the generated classes, e.g., "WifiStateMachine", giving
                   WifiStateMachineTypes, WifiStateMachineData and WifiStateMachineBase
    source:        The diagram the code is generated from
    initial_state: Name of the state [*] transitions to
    states:        List of states, with the initial state first. Each with
                     name:        e.g., "Scanning", giving State::kScanning
                     description: Optional, e.g., "Scan for networks"
                     transitions: List of {target, label}, where label is optional
-#}
// Generated from {{ source }}, do not edit
#pragma once

#include "debug_assert.hh"
#include "timer_manager.hh"

#include <array>
#include <cstdint>
#include <optional>
#include <string_view>
#include <type_traits>
#include <utility>
#include <variant>

// The parts which don't depend on the state data
class {{ class_name }}Types
{
public:
    // Synthetic initial state ([*] in the diagram), which transitions to the first real state
    enum class State : uint8_t
    {
        kGeneratedInitial,
        {%- for state in states %}
        k{{ state.name }},
        {%- endfor %}

        kValueCount,
    };

    // Return from Evaluate() to remain in the current state
    struct StayTag
    {
    };
    static constexpr StayTag kStay {};

    // The return value from Evaluate(), which only accepts the transitions in the diagram.
    // The constructors are consteval, so invalid transitions are compile errors. Each state
    // has its own as <state>::Next, e.g., Evaluate(On&) returns On::Next
    template <State... Allowed>
    class Transition
    {
    public:
        consteval Transition(State to)
            : m_to(to)
        {
            if (!((to == Allowed) || ...))
            {
                TransitionNotInDiagram();
            }
        }

        consteval Transition(StayTag)
        {
        }

        // The state to transition to, or nullopt to stay
        std::optional<State> Target() const
        {
            return m_to;
        }

    private:
        // Deliberately not constexpr, so that calling it fails the compilation
        static void TransitionNotInDiagram()
        {
        }

        std::optional<State> m_to;
    };

    static constexpr std::string_view StateName(State state)
    {
        constexpr auto kNames = std::array<std::string_view, std::to_underlying(State::kValueCount)> {
            "GeneratedInitial",
            {%- for state in states %}
            "{{ state.name }}",
            {%- endfor %}
        };

        return state < State::kValueCount ? kNames[std::to_underlying(state)] : "Invalid";
    }
};

// Default state data. To add data to a state, inherit from this struct and replace that
// state's struct with one inheriting from the default, e.g.,
//
//   struct MyData : {{ class_name }}Data
//   {
//       struct {{ states[0].name }} : {{ class_name }}Data::{{ states[0].name }}
//       {
//           bool started {false};
//       };
//   };
//
// State data is default-constructed on each entry, and destroyed on exit. Next is the
// return type of Evaluate() for the state, with the allowed transitions in the diagram
struct {{ class_name }}Data
{
    using State = {{ class_name }}Types::State;
    template <State... Allowed>
    using Transition = {{ class_name }}Types::Transition<Allowed...>;

    // Common to all states
    struct StateData
    {
    };
    {%- for state in states %}

    {%- if state.description %}

    // {{ state.description }}
    {%- else %}
{# Empty line #}
    {%- endif %}
    struct {{ state.name }} : StateData
    {
        {%- for transition in state.transitions %}
        // -> {{ transition.target }}{% if transition.label %}: {{ transition.label }}{% endif %}
        {%- endfor %}
        using Next = Transition<
            {%- for transition in state.transitions -%}
            State::k{{ transition.target }}{{ ", " if not loop.last }}
            {%- endfor -%}
        >;
    };
    {%- endfor %}
};

template <typename CustomData = {{ class_name }}Data>
class {{ class_name }}Base : public {{ class_name }}Types
{
public:
    static_assert(std::is_base_of_v<{{ class_name }}Data, CustomData>,
                  "The state data must inherit from {{ class_name }}Data");
{% for state in states %}
    using {{ state.name }} = typename CustomData::{{ state.name }};
{%- endfor %}

    virtual ~{{ class_name }}Base() = default;

    State CurrentState() const
    {
        return static_cast<State>(m_state.index());
    }

protected:
    // Evaluate and transition until the state machine is stable. The first call transitions
    // from the synthetic initial state, so Enter() is called for the first real state
    void RunStateMachine()
    {
        for (auto i = 0; i < kMaxTransitionsPerRun; ++i)
        {
            auto next = std::visit(
                [this](auto& state) { return this->Evaluate(state).Target(); }, m_state);
            if (!next)
            {
                return;
            }

            auto from = CurrentState();
            std::visit([this](auto& state) { this->Exit(state); }, m_state);
            // Destroys the old state data, and constructs the new
            EmplaceState(*next, std::make_index_sequence<std::variant_size_v<StateVariant>> {});
            OnTransition(from, *next);
            std::visit([this](auto& state) { this->Enter(state); }, m_state);
        }

        debug_assert(false && "The state machine doesn't settle");
    }

    // Mandatory, return kStay to remain in the state
    {%- for state in states %}
    virtual typename {{ state.name }}::Next Evaluate({{ state.name }}&) = 0;
    {%- endfor %}

    // Optional
    {%- for state in states %}
    virtual void Enter({{ state.name }}&)
    {
    }
    virtual void Exit({{ state.name }}&)
    {
    }
    {%- endfor %}

    // Optional, e.g., for logging. Also called for the transition from kGeneratedInitial
    virtual void OnTransition(State /* from */, State /* to */)
    {
    }

private:
    struct GeneratedInitial
    {
    };

    // [*] -> {{ initial_state }}
    // The synthetic initial state is handled here, and can't be overridden
    Transition<State::k{{ initial_state }}> Evaluate(GeneratedInitial&)
    {
        return State::k{{ initial_state }};
    }
    void Enter(GeneratedInitial&)
    {
    }
    void Exit(GeneratedInitial&)
    {
    }

    // Same order as State
    using StateVariant = std::variant<GeneratedInitial
        {%- for state in states %}, {{ state.name }}{% endfor %}>;

    static_assert(std::variant_size_v<StateVariant> == std::to_underlying(State::kValueCount));

    // Only to catch state machines which never settle
    static constexpr auto kMaxTransitionsPerRun = 256;

    template <size_t... I>
    void EmplaceState(State state, std::index_sequence<I...>)
    {
        ((std::to_underlying(state) == I ? (void)m_state.template emplace<I>() : void()), ...);
    }

    StateVariant m_state;
};

